#!/usr/bin/env bash
# pi-learning: Ali, learning coach. One step at a time, a workspace per topic. Starts in ~/pi-studio/learning.
# A Pi Desktop harness from the character pack (packs/learning): Pi Desktop runs "pi-learning --mode rpc"; in a terminal, "pi-learning"
# is the normal Pi TUI. Installed by scripts/install-pack.sh, which fills in the Pi Desktop folder below.
# Starts in its own workspace so that folder's AGENTS.md and chats belong to this character.
export PI_HARNESS=learning
desk="${PI_DESKTOP_DIR:-__PI_DESKTOP_DIR__}"
pack="$desk/packs/learning"
[[ -d "$pack/skills" ]] || { echo "pi-learning: no pack at $pack (re-run scripts/install-pack.sh learning)" >&2; exit 1; }
# Workspace: $PI_STUDIO/learning if you set PI_STUDIO, else ~/pi-studio/learning. The workspace rules are copied in once.
ws="${PI_STUDIO:-$HOME/pi-studio}/learning"
mkdir -p "$ws"
[[ -f "$ws/AGENTS.md" ]] || cp "$pack/workspace/AGENTS.md" "$ws/AGENTS.md"
# Pi Desktop reads the working folder from the literal cd line below, so the default stays spelled out.
if [[ -z "${PI_STUDIO:-}" ]]; then
  cd "$HOME/pi-studio/learning" || exit 1
else
  cd "$ws" || exit 1
fi
# The terminal face (header + footer) from the pixel-coach extension. It also sends Ali's identity once.
face="$desk/extensions/pixel-coach/index.ts"
ext=(); [[ -f "$face" ]] && ext=(-e "$face")
# Only this pack's skills; your own extensions (and providers, web search) still load.
skills=(--no-skills --skill "$pack/skills/learn")
# Your default provider and model. To pin one, add e.g. --model anthropic/claude-sonnet-5-5 before "$@".
exec pi "${ext[@]}" "${skills[@]}" "$@"
