#!/usr/bin/env bash
# pi-ai: Ilya, AI research partner. Papers, models, first principles. Starts in ~/pi-studio/ai.
# A Pi Desktop harness from the character pack (packs/ai): Pi Desktop runs "pi-ai --mode rpc"; in a terminal, "pi-ai"
# is the normal Pi TUI. Installed by scripts/install-pack.sh, which fills in the Pi Desktop folder below.
# Starts in its own workspace so that folder's AGENTS.md and chats belong to this character.
export PI_HARNESS=ai
desk="${PI_DESKTOP_DIR:-__PI_DESKTOP_DIR__}"
pack="$desk/packs/ai"
[[ -d "$pack/skills" ]] || { echo "pi-ai: no pack at $pack (re-run scripts/install-pack.sh ai)" >&2; exit 1; }
# Workspace: $PI_STUDIO/ai if you set PI_STUDIO, else ~/pi-studio/ai. The workspace rules are copied in once.
ws="${PI_STUDIO:-$HOME/pi-studio}/ai"
mkdir -p "$ws"
[[ -f "$ws/AGENTS.md" ]] || cp "$pack/workspace/AGENTS.md" "$ws/AGENTS.md"
# Pi Desktop reads the working folder from the literal cd line below, so the default stays spelled out.
if [[ -z "${PI_STUDIO:-}" ]]; then
  cd "$HOME/pi-studio/ai" || exit 1
else
  cd "$ws" || exit 1
fi
# The terminal face (header + footer) from the pixel-coach extension. It also sends Ilya's identity once.
face="$desk/extensions/pixel-coach/index.ts"
ext=(); [[ -f "$face" ]] && ext=(-e "$face")
# Only this pack's skills; your own extensions (and providers, web search) still load.
skills=(--no-skills --skill "$pack/skills/ai-research" --skill "$pack/skills/research")
# Your default provider and model. To pin one, add e.g. --model anthropic/claude-sonnet-5-5 before "$@".
exec pi "${ext[@]}" "${skills[@]}" "$@"
