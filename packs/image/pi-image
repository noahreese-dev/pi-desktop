#!/usr/bin/env bash
# pi-image: Narges, artist and creative director. Images with a refinement loop. Starts in ~/pi-studio/image.
# A Pi Desktop harness from the character pack (packs/image): Pi Desktop runs "pi-image --mode rpc"; in a terminal, "pi-image"
# is the normal Pi TUI. Installed by scripts/install-pack.sh, which fills in the Pi Desktop folder below.
# Starts in its own workspace so that folder's AGENTS.md and chats belong to this character.
export PI_HARNESS=image
desk="${PI_DESKTOP_DIR:-__PI_DESKTOP_DIR__}"
pack="$desk/packs/image"
[[ -d "$pack/skills" ]] || { echo "pi-image: no pack at $pack (re-run scripts/install-pack.sh image)" >&2; exit 1; }
# Workspace: $PI_STUDIO/image if you set PI_STUDIO, else ~/pi-studio/image. The workspace rules are copied in once.
ws="${PI_STUDIO:-$HOME/pi-studio}/image"
mkdir -p "$ws"
[[ -f "$ws/AGENTS.md" ]] || cp "$pack/workspace/AGENTS.md" "$ws/AGENTS.md"
# Pi Desktop reads the working folder from the literal cd line below, so the default stays spelled out.
if [[ -z "${PI_STUDIO:-}" ]]; then
  cd "$HOME/pi-studio/image" || exit 1
else
  cd "$ws" || exit 1
fi
# The terminal face (header + footer) from the pixel-coach extension. It also sends Narges's identity once.
face="$desk/extensions/pixel-coach/index.ts"
ext=(); [[ -f "$face" ]] && ext=(-e "$face")
# Only this pack's skills; your own extensions (and providers, any image tool) still load.
skills=(--no-skills --skill "$pack/skills/image" --skill "$pack/skills/image-refinement-loop")
# Your default provider and model. To pin one, add e.g. --model anthropic/claude-sonnet-5-5 before "$@".
exec pi "${ext[@]}" "${skills[@]}" "$@"
