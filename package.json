{
  "name": "pi-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "A desktop chat app for Pi harnesses: each ~/bin/pi-<name> script becomes a character with its own face, voice and chats.",
  "author": "Pi Desktop contributors",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/unit.test.mjs",
    "smoke": "node tests/smoke.mjs",
    "faces": "python3 -I faces/pixel_faces.py",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "40.9.3"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.2.0",
    "marked": "^15.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/noahreese-dev/pi-desktop.git"
  },
  "homepage": "https://github.com/noahreese-dev/pi-desktop#readme",
  "bugs": {
    "url": "https://github.com/noahreese-dev/pi-desktop/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "electron",
    "agent",
    "harness",
    "desktop",
    "chat"
  ],
  "os": [
    "darwin"
  ]
}
