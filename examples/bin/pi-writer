#!/usr/bin/env bash
# pi-writer: Drafts and edits in plain words. Starts in ~/writing.
# A Pi Desktop harness: Pi Desktop runs "pi-writer --mode rpc"; in a terminal, "pi-writer" is the normal Pi TUI.
# Starts in $HOME/writing so that folder's AGENTS.md and chats belong to this character.
export PI_HARNESS=writer
mkdir -p "$HOME/writing"
cd "$HOME/writing" || exit 1
# The terminal face (header + footer) from the pixel-coach extension, if Pi Desktop is where we expect it.
face="${PI_DESKTOP_DIR:-$HOME/pi-desktop}/extensions/pixel-coach/index.ts"
ext=(); [[ -f "$face" ]] && ext=(-e "$face")
exec pi "${ext[@]}" "$@"
